{
  "info": {
    "name": "Restaurant POS API",
    "description": "Complete REST API for Restaurant QR Ordering & POS Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@restaurant.com\",\n  \"password\": \"admin123\"\n}"
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@restaurant.com\",\n  \"password\": \"test123\",\n  \"role\": \"waiter\"\n}"
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN\"\n}" },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@restaurant.com\"\n}" },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Foods",
      "item": [
        {
          "name": "Get All Foods",
          "request": { "method": "GET", "url": "{{baseUrl}}/foods?search=&category=&page=1&limit=10" }
        },
        {
          "name": "Get Food by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/foods/:id" }
        },
        {
          "name": "Create Food",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/foods",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Dish\",\n  \"price\": 15.99,\n  \"category\": \"CATEGORY_ID\",\n  \"description\": \"Delicious\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Public Order (QR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/public",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"T01\",\n  \"customerName\": \"John\",\n  \"customerPhone\": \"+252611234567\",\n  \"items\": [{ \"food\": \"FOOD_ID\", \"quantity\": 2, \"notes\": \"No onions\" }]\n}"
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Get Public Order (Tracking)",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/public/:orderId" }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders?status=&search=",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orders/:id/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"preparing\"\n}" }
          }
        },
        {
          "name": "Kitchen Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/kitchen",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Tables",
      "item": [
        {
          "name": "Get Public Table",
          "request": { "method": "GET", "url": "{{baseUrl}}/tables/public/T01" }
        },
        {
          "name": "Get All Tables",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tables",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Table",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tables",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tableNumber\": \"T11\",\n  \"capacity\": 4\n}" }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": \"ORDER_ID\",\n  \"amount\": 25.99,\n  \"method\": \"cash\",\n  \"discount\": 0\n}"
            }
          }
        },
        {
          "name": "Split Bill",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/split",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": \"ORDER_ID\",\n  \"amount\": 50,\n  \"splitDetails\": [{ \"method\": \"cash\", \"amount\": 30 }, { \"method\": \"evc_plus\", \"amount\": 20 }]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard?period=daily",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/analytics",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Generate Sales Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports?type=sales&period=monthly&format=json",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    }
  ]
}
